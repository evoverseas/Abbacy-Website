# ======================================================================
# ABBACY GLOBAL GROUP (abbacy.in) — PRODUCTION .htaccess
# ======================================================================

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. Force HTTPS & Non-WWW Canonical
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.abbacy\.in [NC]
RewriteRule ^(.*)$ https://abbacy.in/$1 [L,R=301]

# 2. Redirect Legacy & Short URLs (Preserve Link Equity)
RewriteRule ^daad-scholarship(\.html)?$ /daad-scholarship-germany.html [R=301,L]

# 3. Redirect Himayatnagar Variations to Canonical Local Pillar Page
RewriteRule ^study-abroad-consultants-himayat-nagar(\.html)?$ /study-abroad-consultants-himayatnagar.html [R=301,L]
RewriteRule ^study-abroad-consultants-himayathnagar(\.html)?$ /study-abroad-consultants-himayatnagar.html [R=301,L]
RewriteRule ^himayat-nagar(\.html)?$ /study-abroad-consultants-himayatnagar.html [R=301,L]
RewriteRule ^himayatnagar(\.html)?$ /study-abroad-consultants-himayatnagar.html [R=301,L]
RewriteRule ^himayathnagar(\.html)?$ /study-abroad-consultants-himayatnagar.html [R=301,L]
RewriteRule ^study-abroad-consultants-in-himayat-nagar(\.html)?$ /study-abroad-consultants-himayatnagar.html [R=301,L]
RewriteRule ^study-abroad-consultants-in-himayatnagar(\.html)?$ /study-abroad-consultants-himayatnagar.html [R=301,L]
</IfModule>

# 4. Custom Error Document
ErrorDocument 404 /404.html

# 5. Enable GZIP / Deflate Compression for Mobile Speed
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 6. Browser Caching for Core Web Vitals (LCP / Repeat Visits)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 7. Security & Crawl Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
